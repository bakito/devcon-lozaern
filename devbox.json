{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "presenterm@0.16.1",
    "mermaid-cli@11.16.0",
    "python314Packages.weasyprint@68.0",
    "bat@0.26.1",
    "expect@5.45.4",
    "kind@0.32.0",
    "kubectl@1.36.3",
    "k9s@0.51.0",
    "noto-fonts-color-emoji@2.051",
    "kubexporter@0.9.1"
  ],
  "env": {
    "SLIDES":             "kubexporter_kubernetes_backup_better_together.md",
    "KUBEXPORTER_SLIDES": "kubexporter/kubexporter.md",
    "KUBECONFIG":         "$HOME/.kube/kind/kubeconfig/kubexporter-demo"
  },
  "shell": {
    "init_hook": [
      "alias dbrun='devbox run'",
      "case $- in *i*) . \"${DEVBOX_PROJECT_ROOT}/setup/completion.bash\" ;; esac",
      "mkdir -p ~/.local/share/fonts && ln -sf $(find /nix/store -name 'NotoColorEmoji.ttf' -type f 2>/dev/null | head -1) ~/.local/share/fonts/NotoColorEmoji.ttf && fc-cache -f ~/.local/share/fonts/NotoColorEmoji.ttf >/dev/null 2>&1 || true"
    ],
    "scripts": {
      "present": [
        "kind get clusters 2>/dev/null | grep -qx kubexporter-demo || bash setup/setup.sh",
        "kind export kubeconfig --name kubexporter-demo >/dev/null",
        "presenterm ${SLIDES} -c presenterm-config.yaml -x --publish-speaker-notes"
      ],
      "present-sn": [
        "kind get clusters 2>/dev/null | grep -qx kubexporter-demo || bash setup/setup.sh",
        "kind export kubeconfig --name kubexporter-demo >/dev/null",
        "presenterm ${SLIDES} -c presenterm-config.yaml --listen-speaker-notes"
      ],
      "pdf": [
        "presenterm ${SLIDES} -c presenterm-config.yaml --export-pdf"
      ],
      "html": [
        "presenterm ${SLIDES} -c presenterm-config.yaml --export-html",
        "bash setup/center-html.sh kubexporter_kubernetes_backup_better_together.html"
      ],
      "k-present": [
        "kind get clusters 2>/dev/null | grep -qx kubexporter-demo || bash setup/setup.sh",
        "kind export kubeconfig --name kubexporter-demo >/dev/null",
        "presenterm ${KUBEXPORTER_SLIDES} -c presenterm-config.yaml -x"
      ],
      "k-pdf": [
        "presenterm ${KUBEXPORTER_SLIDES} -c presenterm-config.yaml --export-pdf"
      ],
      "k-html": [
        "presenterm ${KUBEXPORTER_SLIDES} -c presenterm-config.yaml --export-html",
        "bash setup/center-html.sh kubexporter_kubernetes_backup_better_together.html"
      ],
      "ci-pdf-export": [
        "expect .github/scripts/expect-tty.exp --rows 30 --cols 120 -- presenterm ${SLIDES} -c presenterm-config.yaml --export-pdf"
      ],
      "ci-html-export": [
        "expect .github/scripts/expect-tty.exp --rows 30 --cols 120 -- presenterm ${SLIDES} -c presenterm-config.yaml --export-html"
      ],
      "ci-k-pdf-export": [
        "expect .github/scripts/expect-tty.exp --rows 30 --cols 120 -- presenterm ${KUBEXPORTER_SLIDES} -c presenterm-config.yaml --export-pdf"
      ],
      "ci-k-html-export": [
        "expect .github/scripts/expect-tty.exp --rows 30 --cols 120 -- presenterm ${KUBEXPORTER_SLIDES} -c presenterm-config.yaml --export-html"
      ],
      "kind-setup": [
        "bash setup/setup.sh"
      ],
      "kind-destroy": [
        "kind delete cluster --name kubexporter-demo"
      ],
      "font-big": [
        "sed -i 's/^font-size = .*/font-size = 24/' ~/.config/ghostty/config.ghostty"
      ],
      "font-reset": [
        "sed -i 's/^font-size = .*/font-size = 12/' ~/.config/ghostty/config.ghostty"
      ]
    }
  }
}
