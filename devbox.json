{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "presenterm@0.16.1",
    "mermaid-cli@11.16.0",
    "python314Packages.weasyprint@69.0",
    "bat@0.26.1",
    "expect@5.45.4"
  ],
  "env": {
    "SLIDES": "kubexporter_kubernetes_backup_better_together.md",
    "KUBEXPORTER_SLIDES": "kubexporter/kubexporter.md"
  },
  "shell": {
    "scripts": {
      "present": [
        "presenterm ${SLIDES} -c config.yaml -x"
      ],
      "pdf": [
        "presenterm ${SLIDES} -c config.yaml --export-pdf"
      ],
      "html": [
        "presenterm ${SLIDES} -c config.yaml --export-html"
      ],
      "k-present": [
        "presenterm ${KUBEXPORTER_SLIDES} -c config.yaml -x"
      ],
      "k-pdf": [
        "presenterm ${KUBEXPORTER_SLIDES} -c config.yaml --export-pdf"
      ],
      "k-html": [
        "presenterm ${KUBEXPORTER_SLIDES} -c config.yaml --export-html"
      ]
    }
  }
}
