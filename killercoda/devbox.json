{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": {
    "presenterm": "0.16.1",
    "bat":        "0.26.1",
    "k9s":        "0.51.0",
    "expect":     "5.45.4",
    "age":        "1.3.2",
    "krew":       "0.5.0"
  },
  "env": {
    "SLIDES":            "kubexporter_kubernetes_backup_better_together.md",
    "KILLERCODA_MODE":   "true",
    "PRESENTATION_ROOT": "${DEVBOX_PROJECT_ROOT}/..",
    "EXPORTS":            "/tmp/kubexporter-demo/exports",
    "SECRET":             "/tmp/kubexporter-demo/exports/kubexporter-test/Secret.kubexporter-secret.yaml",
    "NAMESPACE":          "kubexporter-test"
  },
  "shell": {
    "init_hook": [
      "alias dbrun='devbox run'",
      "case $- in *i*) . \"${DEVBOX_PROJECT_ROOT}/../setup/completion.bash\" ;; esac",
      "echo \"Install update kubectl KubExporter plugin\"",
      "krew install krew exporter >/dev/null 2>&1",
      "krew upgrade exporter >/dev/null 2>&1 || true",
      "export PATH=\"${KREW_ROOT:-$HOME/.krew}/bin:$PATH\""
    ],
    "scripts": {
      "present": [
        "cd ${DEVBOX_PROJECT_ROOT}/../ && presenterm ${SLIDES} -c presenterm-config.yaml -x"
      ],
      "k8s-setup": [
        "bash ../setup/setup.sh"
      ]
    }
  }
}
