{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": {
    "presenterm": "0.16.1",
    "bat":        "0.26.1",
    "k9s":        "0.51.0",
    "expect":     "5.45.4",
    "age":        "1.3.2",
    "krew":       "0.5.0"
  },
  "env": {
    "SLIDES":            "kubexporter_kubernetes_backup_better_together.md",
    "KILLERCODA_MODE":   "true",
    "PRESENTATION_ROOT": "${DEVBOX_PROJECT_ROOT}/.."
  },
  "shell": {
    "init_hook": [
      "alias dbrun='devbox run'",
      "case $- in *i*) . \"${DEVBOX_PROJECT_ROOT}/../setup/completion.bash\" ;; esac"
    ],
    "scripts": {
      "present": [
        "cd ${DEVBOX_PROJECT_ROOT}/../ && presenterm ${SLIDES} -c presenterm-config.yaml -x"
      ],
      "k8s-setup": [
        "bash ../setup/setup.sh"
      ]
    }
  }
}
